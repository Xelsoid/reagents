{
  "extends": "@tsconfig/node16/tsconfig.json",
  "compilerOptions": {
    "removeComments": true,
    "outDir": "./dist",
    "rootDir": "./",
    "allowJs": true,
    "maxNodeModuleJsDepth": 10,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
