  "bugs": {
    "url": "https://github.com/Xelsoid/reagents/issues"
  },
  "homepage": "https://github.com/Xelsoid/reagents#readme",
  "devDependencies": {
    "@netlify/functions": "2.6.0",
    "netlify-cli": "15.0.2",
    "netlify-lambda": "2.0.16",
    "serverless-http": "3.2.0"
  }
}
