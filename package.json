{
  "name": "reagents",
  "version": "1.0.0",
  "description": "Reagents",
  "esModuleInterop": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start:nodejs": "npm run dev -w server",
    "start:react": "npm run start -w client",
