    "netlify:dev": "netlify dev",
    "deploy:preview": "netlify deploy",
    "deploy:production": "netlify deploy --prod",
    "clean": "rimraf ./node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xelsoid/reagents.git"
  },
